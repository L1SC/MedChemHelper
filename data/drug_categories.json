  "sar": [
    {
      "id": "sar-penicillin",
      "title": "青霉素类构效关系",
      "image": "/static/sar-penicillin.svg?v=2",
      "summary": "青霉素母核的β-内酰胺环、2位羧基和6位酰氨基是活性关键；6位侧链是最重要的可修饰区域。",
      "points": ["β-内酰胺环、2位羧基和6位酰氨基为抗菌活性所必需", "6位酰胺侧链决定耐酸、耐酶和抗菌谱等性质", "6位引入甲氧基可提高对细菌β-内酰胺酶的稳定性", "3位甲基和4位硫原子可由其他基团或原子替换"],
      "source": "药物化学，PDF第130-131页（书页122-123），图8-4"
    },
    {
      "id": "sar-cephalosporin",
      "title": "头孢菌素类构效关系",
      "image": "/static/sar-cephalosporin.svg?v=2",
      "summary": "头孢菌素母核两侧链及环上取代共同调节抗菌谱、耐酶性、效力、稳定性与药动性质。",
      "points": ["7位酰氨基侧链是决定抗菌谱的重要区域", "7位侧链邻近取代影响对β-内酰胺酶的稳定性", "母核上的部分取代影响抗菌效力", "3位取代可同时影响稳定性、抗菌效力与药动性质"],
      "source": "药物化学，PDF第131页（书页123）"
    },
    {
      "id": "sar-tetracycline",
      "title": "四环素类构效关系",
      "image": "/static/sar-tetracycline.svg?v=2",
      "summary": "四环稠合母核中1—4位和11、12位关键，5—9位可用于优化活性、稳定性和代谢。",
      "points": ["1—4位取代基是活性必需部分", "11、12位二酮结构为活性所必需", "5—9位允许修饰，可改善抗菌活性、稳定性和代谢性能", "6位碳可用硫替换，活性可能升高但毒副作用也会增加"],
      "source": "药物化学，PDF第137页（书页129）"
    },
    {
      "id": "sar-erythromycin",
      "title": "红霉素构效关系",
      "image": "/static/sar-erythromycin.svg?v=2",
      "summary": "大环内酯环和二甲氨基糖是活性关键，6位和9位是改善酸稳定性与活性的主要位置。",
      "points": ["大环内酯结构和二甲氨基为活性必需", "9位羰基重要，还原后活性消失，但可进行肟或氨基相关改造", "6位羟基甲基化可增加酸稳定性", "克拉定糖不是活性必需部分"],
      "source": "药物化学，PDF第141页（书页133）"
    },
    {
      "id": "sar-sulfonamide",
      "title": "磺胺类抗菌药构效关系",
      "image": "/static/sar-sulfonamide.svg?v=2",
      "summary": "对氨基苯磺酰胺是核心，氨基的状态、磺酰胺位置和氮上取代方式共同决定活性。",
      "points": ["对位氨基须保持游离或可在体内恢复为游离状态", "磺酰胺基必须位于氨基对位，邻位或间位取代无活性", "磺酰胺氮单取代通常增强活性，杂环取代更有利", "磺酰胺氮双取代会使活性丧失；芳环被替换通常降低或丧失活性"],
      "source": "药物化学，PDF第150页（书页142）"
    },
    {
      "id": "sar-quinolone",
      "title": "喹诺酮类抗菌药构效关系",
      "image": "/static/sar-quinolone.svg?v=2",
      "summary": "1,4-二氢-4-氧代喹啉-3-羧酸母核为基础，1、5、6、7、8位取代用于调节活性与性质。",
      "points": ["3位羧基和4位羰基是药效关键，2位取代通常使活性降低或消失", "6位取代影响显著，教材给出的活性顺序为F>Cl>CN>NH₂>H", "7位以哌嗪基最有利，其他取代也会改变抗菌活性", "1位以乙基、环丙基、氟乙基或带吸电子基的芳基较好；5位氨基、8位Cl/F/OCH₃可增强活性"],
      "source": "药物化学，PDF第154页（书页146）"
    }
  ]
